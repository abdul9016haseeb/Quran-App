{
  "name": "tamil-quran-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@expo-google-fonts/noto-serif-tamil": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "~58.0.26",
    "expo-font": "~58.0.12",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "apk:debug": "cd android && ./gradlew :app:assembleDebug -PreactNativeArchitectures=${TAMIL_QURAN_ARCHS:-arm64-v8a,x86_64}",
    "apk:release": "cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a,x86,x86_64",
    "device:tcpip": "sh scripts/adb-tcpip.sh",
    "device:list": "adb devices -l",
    "device:reverse": "sh scripts/adb-target.sh reverse tcp:8081 tcp:8081",
    "device:install": "sh scripts/adb-target.sh install -r android/app/build/outputs/apk/debug/app-debug.apk && npm run device:reverse",
    "device:install:release": "sh scripts/adb-target.sh install -r android/app/build/outputs/apk/release/app-release.apk",
    "device:logcat": "sh scripts/adb-target.sh logcat -s ReactNativeJS:V ReactNative:V",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "lint": "eslint ."
  },
  "private": true
}
